# =========================================================
# n8n MASTER CONFIG (Render + GitHub + PostgreSQL)
# =========================================================

# ---------------- HOST ----------------
N8N_HOST=${N8N_HOST}
N8N_PORT=${PORT}
N8N_PROTOCOL=https

WEBHOOK_URL=${WEBHOOK_URL}
N8N_EDITOR_BASE_URL=${N8N_EDITOR_BASE_URL}

GENERIC_TIMEZONE=${GENERIC_TIMEZONE}
TZ=${TZ}

# ---------------- SECURITY ----------------
N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY}

N8N_SECURE_COOKIE=false
N8N_TRUSTED_PROXIES=0.0.0.0/0
# ⚠️ SECURITY NOTE (public template — read before deploying):
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false lets Code nodes read ALL process
# env vars (including DB_POSTGRESDB_CONNECTION_URL, N8N_ENCRYPTION_KEY,
# API keys). NODE_FUNCTION_ALLOW_EXTERNAL=* lets Code nodes import ANY
# npm package. Fine for a single trusted owner; if other people will
# have editor/workflow access, set N8N_BLOCK_ENV_ACCESS_IN_NODE=true
# and replace NODE_FUNCTION_ALLOW_EXTERNAL=* with a specific allow-list.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# ---------------- DATABASE ----------------
# entrypoint.sh parses this single URL into the DB_POSTGRESDB_HOST/PORT/
# DATABASE/USER/PASSWORD/SSL_ENABLED vars that n8n actually reads.
DB_TYPE=postgresdb
DB_POSTGRESDB_CONNECTION_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---------------- EXECUTIONS ----------------
EXECUTIONS_MODE=regular
EXECUTIONS_PROCESS=main
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_TIMEOUT_MAX=7200

# ---------------- PRUNING ----------------
N8N_PRUNING_ENABLED=true
N8N_PRUNING_EXECUTION_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=5000

# ---------------- STORAGE ----------------
N8N_DATA_FOLDER=/home/n8n/.n8n
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ---------------- PERFORMANCE ----------------
NODE_OPTIONS=--max-old-space-size=384
N8N_CONCURRENCY_PRODUCTION_LIMIT=2
N8N_RUNNERS_ENABLED=true

# ---------------- LOG ----------------
N8N_LOG_LEVEL=warn
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_TEMPLATES_ENABLED=false

# ---------------- CODE NODE ----------------
NODE_FUNCTION_ALLOW_BUILTIN=*
NODE_FUNCTION_ALLOW_EXTERNAL=*

# ---------------- AUTH ----------------
N8N_BASIC_AUTH_ACTIVE=${N8N_BASIC_AUTH_ACTIVE}
N8N_BASIC_AUTH_USER=${N8N_BASIC_AUTH_USER}
N8N_BASIC_AUTH_PASSWORD=${N8N_BASIC_AUTH_PASSWORD}
