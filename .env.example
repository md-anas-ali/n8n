# =========================================================
# Safe to commit/share: secrets are ${PLACEHOLDER}, fill in Render
# dashboard "Environment" tab (sync: false vars in render.yaml).
# Fixed values below are managed centrally by render.yaml.
# =========================================================

# ---------------- HOST ----------------
N8N_HOST=${N8N_HOST}
N8N_PROTOCOL=https
N8N_PORT=5678

WEBHOOK_URL=${WEBHOOK_URL}
N8N_EDITOR_BASE_URL=${N8N_EDITOR_BASE_URL}
APP_REFERER_URL=${APP_REFERER_URL}

GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka

# ---------------- DATABASE ----------------
DB_TYPE=postgresdb
DB_POSTGRESDB_CONNECTION_URL=${DB_POSTGRESDB_CONNECTION_URL}

# ---------------- SECURITY ----------------
N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY}
# Same key used across all 3 accounts — 9dK7vP2xLmQ8rZ4nYf6HsA1wEc5TuJ3BgN8qRxM7ZaWpL2V

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=${N8N_BASIC_AUTH_USER}
N8N_BASIC_AUTH_PASSWORD=${N8N_BASIC_AUTH_PASSWORD}

# ---------------- EXECUTIONS / PRUNING ----------------
EXECUTIONS_TIMEOUT=3600
N8N_PRUNING_ENABLED=true
N8N_PRUNING_EXECUTION_DATA_MAX_AGE=24
EXECUTIONS_DATA_PRUNE_MAX_COUNT=5000

# ---------------- STORAGE / PERFORMANCE ----------------
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
NODE_OPTIONS=--max-old-space-size=256
N8N_CONCURRENCY_PRODUCTION_LIMIT=1
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=false
# FIX (2026-08-04): disabled — avoids the 403 grant-token race on
# Render's 0.1 CPU free tier (n8n GitHub issue #28638).
N8N_RUNNERS_ENABLED=false
NODE_FUNCTION_ALLOW_BUILTIN=fs

# ---------------- LOG / INSTANCE BEHAVIOUR ----------------
N8N_LOG_LEVEL=warn
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# ---------------- AI SCRIPT GENERATION ----------------
GEMINI_API_KEY=${GEMINI_API_KEY}
GOOGLE_API_KEY=${GOOGLE_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
RENDER_AI_URL=${RENDER_AI_URL}
RENDER_AI_API_KEY=${RENDER_AI_API_KEY}

# ---------------- VOICE / TTS ----------------
ELEVENLABS_API_KEY=${ELEVENLABS_API_KEY}
ELEVENLABS_VOICE_ID=${ELEVENLABS_VOICE_ID}
EDGE_TTS_VOICE=en-US-AndrewNeural
RENDER_TTS_URL=${RENDER_TTS_URL}
RENDER_TTS_API_KEY=${RENDER_TTS_API_KEY}
RENDER_TTS_VOICE=en-US-GuyNeural

# ---------------- YOUTUBE UPLOAD ----------------
YOUTUBE_DATA_API_KEY=${YOUTUBE_DATA_API_KEY}
YOUTUBE_CATEGORY_ID=24

# ---------------- CONTENT / TRENDS ----------------
CONTENT_CATEGORY=Entertainment
TRENDS_REGION=US

# ---------------- GOOGLE SHEET (topics / QC log) ----------------
GOOGLE_SHEET_ID=${GOOGLE_SHEET_ID}
GOOGLE_SHEET_TAB_USED_TOPICS=UsedTopics
GOOGLE_SHEET_TAB_QC_LOG=QC Log

# ---------------- NOTIFICATIONS ----------------
NOTIFY_EMAIL_SUCCESS=${NOTIFY_EMAIL_SUCCESS}
NOTIFY_EMAIL_ERROR=${NOTIFY_EMAIL_ERROR}
NOTIFY_WEBHOOK_URL=${NOTIFY_WEBHOOK_URL}
